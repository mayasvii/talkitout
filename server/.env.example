# Server Port
PORT=5000

# Client URL (for CORS allowance, e.g. http://localhost:3000 or production https://talkitout.vercel.app)
CLIENT_URL=http://localhost:3000

# MongoDB Connection String (MongoDB Atlas URI or local mongodb://localhost:27017/talkitout)
MONGO_URI=mongodb://localhost:27017/talkitout

# JSON Web Token Secret Key and Expiry
JWT_SECRET=talkitout_super_secret_jwt_key_2026_capstone
JWT_EXPIRE=30d

# Razorpay Test Mode Credentials
# Replace with your test keys from https://dashboard.razorpay.com/#/app/keys
RAZORPAY_KEY_ID=rzp_test_placeholder_key_id
RAZORPAY_KEY_SECRET=rzp_test_placeholder_key_secret
